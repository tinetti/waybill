#!/usr/bin/env node
// The shell surface, and deliberately the thinnest file in the repository.
//
// Every flag, every subcommand, and every usage message lives in `src/cli.js`, because the slash
// commands invoke that module directly: a second parser here would be a second thing to keep in
// step with, and the two surfaces would drift the first time either gained an option.
//
// `process.exitCode` rather than `process.exit`, so a large waybill on a pipe is flushed before the
// process ends.
import { run } from '../src/cli.js';

// `run` answers with a number for every verb but one: `fleet` on a TTY hands back a promise that
// settles when the operator leaves the live view. Resolving either shape here keeps the exit code
// the single thing this file is responsible for.
Promise.resolve(run(process.argv.slice(2))).then((code) => {
  process.exitCode = code;
});
